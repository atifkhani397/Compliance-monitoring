{
  "$defs": {
    "AlertPayload": {
      "additionalProperties": false,
      "description": "Payload for ALERT messages.",
      "properties": {
        "affected_entities": {
          "items": {
            "type": "string"
          },
          "title": "Affected Entities",
          "type": "array"
        },
        "agent_status": {
          "anyOf": [
            {
              "enum": [
                "HEALTHY",
                "DEGRADED",
                "STOPPED"
              ],
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Agent Status"
        },
        "attributed_entity": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Attributed Entity"
        },
        "board_level": {
          "default": false,
          "title": "Board Level",
          "type": "boolean"
        },
        "conflict_type": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Conflict Type"
        },
        "consensus_result": {
          "anyOf": [
            {
              "additionalProperties": true,
              "type": "object"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Consensus Result"
        },
        "cross_jurisdictional": {
          "default": false,
          "title": "Cross Jurisdictional",
          "type": "boolean"
        },
        "detected_at": {
          "title": "Detected At",
          "type": "string"
        },
        "evidence_refs": {
          "items": {
            "type": "string"
          },
          "title": "Evidence Refs",
          "type": "array"
        },
        "exculpatory": {
          "default": false,
          "title": "Exculpatory",
          "type": "boolean"
        },
        "jurisdiction": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Jurisdiction"
        },
        "mria": {
          "default": false,
          "title": "Mria",
          "type": "boolean"
        },
        "regulatory_requirement": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Regulatory Requirement"
        },
        "repeated_violation_count": {
          "default": 0,
          "minimum": 0,
          "title": "Repeated Violation Count",
          "type": "integer"
        },
        "required_skills": {
          "items": {
            "type": "string"
          },
          "title": "Required Skills",
          "type": "array"
        },
        "sanctions_related": {
          "default": false,
          "title": "Sanctions Related",
          "type": "boolean"
        },
        "senior_management": {
          "default": false,
          "title": "Senior Management",
          "type": "boolean"
        },
        "severity": {
          "enum": [
            "LOW",
            "MEDIUM",
            "HIGH",
            "CRITICAL"
          ],
          "title": "Severity",
          "type": "string"
        },
        "system_generated_anomaly": {
          "default": false,
          "title": "System Generated Anomaly",
          "type": "boolean"
        },
        "violation_type": {
          "title": "Violation Type",
          "type": "string"
        }
      },
      "required": [
        "violation_type",
        "severity",
        "detected_at",
        "evidence_refs",
        "affected_entities"
      ],
      "title": "AlertPayload",
      "type": "object"
    },
    "ConsensusPayload": {
      "additionalProperties": false,
      "description": "Consensus result embedded in an UPDATE message.",
      "properties": {
        "audit_trail_ref": {
          "title": "Audit Trail Ref",
          "type": "string"
        },
        "conflict_type": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Conflict Type"
        },
        "consensus_confidence": {
          "maximum": 1.0,
          "minimum": 0.0,
          "title": "Consensus Confidence",
          "type": "number"
        },
        "consensus_severity": {
          "enum": [
            "CRITICAL",
            "HIGH",
            "MEDIUM",
            "LOW",
            "NO_ALERT"
          ],
          "title": "Consensus Severity",
          "type": "string"
        },
        "contributing_agents": {
          "items": {
            "type": "string"
          },
          "title": "Contributing Agents",
          "type": "array"
        },
        "dissenting_agents": {
          "items": {
            "type": "string"
          },
          "title": "Dissenting Agents",
          "type": "array"
        },
        "escalation_reason": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Escalation Reason"
        },
        "escalation_required": {
          "title": "Escalation Required",
          "type": "boolean"
        },
        "resolution_method": {
          "enum": [
            "bayesian",
            "dempster_shafer",
            "hybrid",
            "escalation"
          ],
          "title": "Resolution Method",
          "type": "string"
        }
      },
      "required": [
        "consensus_confidence",
        "consensus_severity",
        "contributing_agents",
        "dissenting_agents",
        "resolution_method",
        "escalation_required",
        "audit_trail_ref"
      ],
      "title": "ConsensusPayload",
      "type": "object"
    },
    "EscalationPayload": {
      "additionalProperties": false,
      "description": "Payload for ESCALATION messages.",
      "properties": {
        "assigned_to": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Assigned To"
        },
        "conflict_type": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Conflict Type"
        },
        "decision_support_package_ref": {
          "title": "Decision Support Package Ref",
          "type": "string"
        },
        "escalation_reason": {
          "title": "Escalation Reason",
          "type": "string"
        },
        "human_assignee_role": {
          "title": "Human Assignee Role",
          "type": "string"
        },
        "recommended_tier": {
          "enum": [
            "TIER_1",
            "TIER_2",
            "TIER_3",
            "TIER_4"
          ],
          "title": "Recommended Tier",
          "type": "string"
        },
        "sla_deadline": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Sla Deadline"
        },
        "status": {
          "anyOf": [
            {
              "enum": [
                "open",
                "in_review",
                "resolved",
                "auto_escalated",
                "overridden"
              ],
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Status"
        },
        "tier": {
          "anyOf": [
            {
              "maximum": 4,
              "minimum": 1,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Tier"
        }
      },
      "required": [
        "escalation_reason",
        "recommended_tier",
        "decision_support_package_ref",
        "human_assignee_role"
      ],
      "title": "EscalationPayload",
      "type": "object"
    },
    "FeedbackPayload": {
      "additionalProperties": false,
      "description": "Labeled feedback carried by an UPDATE message.",
      "properties": {
        "agent_id": {
          "title": "Agent Id",
          "type": "string"
        },
        "alert_id": {
          "title": "Alert Id",
          "type": "string"
        },
        "confidence_after": {
          "anyOf": [
            {
              "maximum": 1.0,
              "minimum": 0.0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Confidence After"
        },
        "confidence_before": {
          "maximum": 1.0,
          "minimum": 0.0,
          "title": "Confidence Before",
          "type": "number"
        },
        "decision_id": {
          "title": "Decision Id",
          "type": "string"
        },
        "human_decision": {
          "enum": [
            "approve",
            "reject",
            "override",
            "request_more_info"
          ],
          "title": "Human Decision",
          "type": "string"
        },
        "justification": {
          "title": "Justification",
          "type": "string"
        },
        "timestamp": {
          "title": "Timestamp",
          "type": "string"
        },
        "violation_type": {
          "title": "Violation Type",
          "type": "string"
        }
      },
      "required": [
        "decision_id",
        "alert_id",
        "agent_id",
        "violation_type",
        "human_decision",
        "confidence_before",
        "justification",
        "timestamp"
      ],
      "title": "FeedbackPayload",
      "type": "object"
    },
    "HeartbeatPayload": {
      "additionalProperties": false,
      "description": "Payload for HEARTBEAT messages.",
      "properties": {
        "agent_status": {
          "enum": [
            "HEALTHY",
            "DEGRADED",
            "UNHEALTHY"
          ],
          "title": "Agent Status",
          "type": "string"
        },
        "last_processed_timestamp": {
          "title": "Last Processed Timestamp",
          "type": "string"
        },
        "queue_depth": {
          "minimum": 0,
          "title": "Queue Depth",
          "type": "integer"
        }
      },
      "required": [
        "agent_status",
        "queue_depth",
        "last_processed_timestamp"
      ],
      "title": "HeartbeatPayload",
      "type": "object"
    },
    "HumanDecisionPayload": {
      "additionalProperties": false,
      "description": "Human disposition carried by an UPDATE message.",
      "properties": {
        "confidence_after": {
          "maximum": 1.0,
          "minimum": 0.0,
          "title": "Confidence After",
          "type": "number"
        },
        "decided_at": {
          "title": "Decided At",
          "type": "string"
        },
        "decided_by": {
          "title": "Decided By",
          "type": "string"
        },
        "decision": {
          "enum": [
            "approve",
            "reject",
            "override",
            "request_more_info"
          ],
          "title": "Decision",
          "type": "string"
        },
        "justification": {
          "title": "Justification",
          "type": "string"
        }
      },
      "required": [
        "decision",
        "justification",
        "decided_by",
        "decided_at",
        "confidence_after"
      ],
      "title": "HumanDecisionPayload",
      "type": "object"
    },
    "QueryPayload": {
      "additionalProperties": false,
      "description": "Payload for QUERY messages.",
      "properties": {
        "parameters": {
          "additionalProperties": true,
          "title": "Parameters",
          "type": "object"
        },
        "query_type": {
          "title": "Query Type",
          "type": "string"
        },
        "response_schema_required": {
          "title": "Response Schema Required",
          "type": "string"
        }
      },
      "required": [
        "query_type",
        "parameters",
        "response_schema_required"
      ],
      "title": "QueryPayload",
      "type": "object"
    },
    "ResponsePayload": {
      "additionalProperties": false,
      "description": "Payload for RESPONSE messages.",
      "properties": {
        "errors": {
          "items": {
            "type": "string"
          },
          "title": "Errors",
          "type": "array"
        },
        "query_id": {
          "title": "Query Id",
          "type": "string"
        },
        "resolution_method": {
          "anyOf": [
            {
              "enum": [
                "bayesian",
                "dempster_shafer",
                "hybrid",
                "escalation"
              ],
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Resolution Method"
        },
        "result_data": {
          "additionalProperties": true,
          "title": "Result Data",
          "type": "object"
        },
        "status": {
          "enum": [
            "SUCCESS",
            "PARTIAL",
            "FAILED"
          ],
          "title": "Status",
          "type": "string"
        }
      },
      "required": [
        "query_id",
        "status",
        "result_data",
        "errors"
      ],
      "title": "ResponsePayload",
      "type": "object"
    },
    "UpdatePayload": {
      "additionalProperties": false,
      "description": "Payload for UPDATE messages.",
      "properties": {
        "changed_fields": {
          "additionalProperties": true,
          "title": "Changed Fields",
          "type": "object"
        },
        "consensus_result": {
          "anyOf": [
            {
              "$ref": "#/$defs/ConsensusPayload"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "entity_id": {
          "title": "Entity Id",
          "type": "string"
        },
        "feedback": {
          "anyOf": [
            {
              "$ref": "#/$defs/FeedbackPayload"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "human_decision": {
          "anyOf": [
            {
              "$ref": "#/$defs/HumanDecisionPayload"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "previous_values": {
          "additionalProperties": true,
          "title": "Previous Values",
          "type": "object"
        },
        "update_type": {
          "title": "Update Type",
          "type": "string"
        }
      },
      "required": [
        "update_type",
        "entity_id",
        "changed_fields",
        "previous_values"
      ],
      "title": "UpdatePayload",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "description": "Base inter-agent message container model.",
  "properties": {
    "audit_classification": {
      "enum": [
        "REGULATORY",
        "OPERATIONAL",
        "DIAGNOSTIC"
      ],
      "title": "Audit Classification",
      "type": "string"
    },
    "confidence_score": {
      "anyOf": [
        {
          "maximum": 1.0,
          "minimum": 0.0,
          "type": "number"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Confidence Score"
    },
    "correlation_id": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "description": "UUID v4 correlation ID.",
      "title": "Correlation Id"
    },
    "message_id": {
      "description": "UUID v4 message identifier.",
      "title": "Message Id",
      "type": "string"
    },
    "message_type": {
      "enum": [
        "ALERT",
        "QUERY",
        "RESPONSE",
        "UPDATE",
        "HEARTBEAT",
        "ESCALATION"
      ],
      "title": "Message Type",
      "type": "string"
    },
    "nonce": {
      "minLength": 16,
      "title": "Nonce",
      "type": "string"
    },
    "payload": {
      "anyOf": [
        {
          "$ref": "#/$defs/AlertPayload"
        },
        {
          "$ref": "#/$defs/QueryPayload"
        },
        {
          "$ref": "#/$defs/ResponsePayload"
        },
        {
          "$ref": "#/$defs/UpdatePayload"
        },
        {
          "$ref": "#/$defs/HeartbeatPayload"
        },
        {
          "$ref": "#/$defs/EscalationPayload"
        },
        {
          "$ref": "#/$defs/ConsensusPayload"
        },
        {
          "$ref": "#/$defs/HumanDecisionPayload"
        },
        {
          "$ref": "#/$defs/FeedbackPayload"
        },
        {
          "additionalProperties": true,
          "type": "object"
        }
      ],
      "description": "Structured message payload dictionary.",
      "title": "Payload"
    },
    "payload_schema": {
      "description": "Pattern matching payload schema.",
      "title": "Payload Schema",
      "type": "string"
    },
    "priority": {
      "description": "Priority level 1 to 5.",
      "maximum": 5,
      "minimum": 1,
      "title": "Priority",
      "type": "integer"
    },
    "protocol_version": {
      "description": "Semver version string.",
      "title": "Protocol Version",
      "type": "string"
    },
    "recipient_agent_id": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "items": {
            "type": "string"
          },
          "type": "array"
        }
      ],
      "description": "Single agent ID or list of IDs.",
      "title": "Recipient Agent Id"
    },
    "retry_count": {
      "default": 0,
      "minimum": 0,
      "title": "Retry Count",
      "type": "integer"
    },
    "sender_agent_id": {
      "description": "Sender agent ID.",
      "title": "Sender Agent Id",
      "type": "string"
    },
    "sender_signature": {
      "minLength": 1,
      "title": "Sender Signature",
      "type": "string"
    },
    "timestamp": {
      "description": "ISO 8601 UTC timestamp.",
      "title": "Timestamp",
      "type": "string"
    },
    "trace_id": {
      "description": "UUID v4 distributed trace ID.",
      "title": "Trace Id",
      "type": "string"
    },
    "ttl_seconds": {
      "maximum": 86400,
      "minimum": 1,
      "title": "Ttl Seconds",
      "type": "integer"
    }
  },
  "required": [
    "message_id",
    "protocol_version",
    "timestamp",
    "sender_agent_id",
    "recipient_agent_id",
    "message_type",
    "priority",
    "trace_id",
    "payload_schema",
    "payload",
    "ttl_seconds",
    "audit_classification",
    "sender_signature",
    "nonce"
  ],
  "title": "BaseMessage",
  "type": "object"
}
